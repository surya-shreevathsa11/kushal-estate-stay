# Vara API (no trailing slash). Leave empty in local Vite to use /api proxy → localhost:3000
VITE_API_BASE_URL=https://api.varalabs.in

# Must match the property slug in Vara
VITE_PROPERTY_SLUG=kushal-estate-stay

# OAuth Web client ID — must match API GUEST_GOOGLE_CLIENT_ID or GOOGLE_CLIENT_ID
VITE_GOOGLE_CLIENT_ID=

# Razorpay key (checkout — wired by Sathwik when payments go live)
VITE_RAZORPAY_KEY_ID=
